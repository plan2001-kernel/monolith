#!/bin/rc
# Plan2001's site for 9front's rc-httpd, on https behind tlssrv
# (/rc/bin/service/tcp17443, tcp443): static pages from $web (default
# /sys/lib/plan2001/web) - another project's page, such as the wasm32
# machine's (Monolith's, whose own select-handler adds its WebSockets)
# or Plan9-wasm32's live image.  rc-httpd sources this file: $location,
# $reqlines are its.
if(~ $#web 0)
	web=/sys/lib/plan2001/web
exec $rc_httpd_dir/handlers/plan2001-static $web
