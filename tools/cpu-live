#!/bin/bash
# Bring a running Plan2001 CPU server's compute pool up to date from this
# repo, through a 9pterm session (tools/9pterm), without a reboot: rcc,
# and crsrv, restarted with its own arguments (tools/cpu-live.rc says what
# each means).  The session's 9pterm sees this repo at /mnt/term.
#   tools/cpu-live SOCK [rcc|crsrv]...
# e.g. tools/cpu-live ~/.cache/9pterm.sock          (the cloud)
#      tools/cpu-live ~/.cache/9pterm-local.sock    (the local CPU VM)
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
[ $# -ge 1 ] || { echo "usage: tools/cpu-live SOCK [rcc|crsrv]..." >&2; exit 2; }
sock=$1; shift
exec "$root/tools/9pterm" -S "$sock" -T 600 \
	-c "rc /mnt/term$root/tools/cpu-live.rc /mnt/term$root $*"
